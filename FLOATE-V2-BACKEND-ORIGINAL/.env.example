# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
PUBLIC_SITE_URL="https://www.floate.xyz"
CORS_ALLOWED_ORIGINS=""

# RESEND: Email Gateway routing for automated behavioral enforcement
RESEND_API_KEY=""

# FLUTTERWAVE: Secure online card/bank payment options
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
# Set this same value as the Flutterwave webhook secret hash. Webhook URL: /api/webhooks/flutterwave
FLW_SECRET_HASH=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_AUTH_DESTINATION_PHONE=""
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_VERIFICATION_APPROVED_TEMPLATE=""
WHATSAPP_VERIFICATION_REJECTED_TEMPLATE=""
FLOATE_JWT_SECRET=""
GEMINI_VOICE_TRANSCRIPTIONS_PER_SENDER_PER_HOUR="6"
GEMINI_VOICE_TRANSCRIPTIONS_GLOBAL_PER_HOUR="120"

# FLOATE BOT & COMMERCE API
VITE_FLOATE_BACKEND_URL=""
NEXT_PUBLIC_FLOATE_BACKEND_URL=""
VITE_API_BASE_URL=""
VITE_API_BASE=""
VITE_WHATSAPP_VERIFY_TOKEN="marketplace_webhook_verify_token_secure_xyz"
FLOATE_UPSTREAM_BACKEND_URL=""
FLOATE_API_KEY="floate_live_sk_7f8a92b3c4e5d6"
FLOATE_SEARCH_API_KEY="floate_live_sk_7f8a92b3c4e5d6"
# Set a strong secret to unlock /admin/ads and protected admin APIs.
ADMIN_API_KEY=""
# Service account JSON with Firestore access for server-only campaign management.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=""
# Optional: exact bucket name from Firebase Console > Storage (without gs://).
FIREBASE_STORAGE_BUCKET=""
# Cloudinary credentials for admin banners and merchant product images.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Bachs.io server-only payment credentials. Use sandbox keys while testing.
BACHS_API_KEY=""
BACHS_BASE_URL="https://sandbox-api.bachs.io"
BACHS_WEBHOOK_SECRET=""
