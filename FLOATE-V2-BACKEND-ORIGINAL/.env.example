# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
PUBLIC_SITE_URL="https://www.floate.xyz"
CORS_ALLOWED_ORIGINS=""

# RESEND: Email Gateway routing for automated behavioral enforcement
RESEND_API_KEY=""

# FLUTTERWAVE: Secure online card/bank payment options
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_SECRET_HASH=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_AUTH_DESTINATION_PHONE=""
FLOATE_JWT_SECRET=""
GEMINI_VOICE_TRANSCRIPTIONS_PER_SENDER_PER_HOUR="6"
GEMINI_VOICE_TRANSCRIPTIONS_GLOBAL_PER_HOUR="120"

# FLOATE BOT & COMMERCE API
VITE_FLOATE_BACKEND_URL=""
NEXT_PUBLIC_FLOATE_BACKEND_URL=""
VITE_API_BASE_URL=""
VITE_API_BASE=""
VITE_WHATSAPP_VERIFY_TOKEN="marketplace_webhook_verify_token_secure_xyz"
FLOATE_UPSTREAM_BACKEND_URL=""
FLOATE_API_KEY="floate_live_sk_7f8a92b3c4e5d6"
FLOATE_SEARCH_API_KEY="floate_live_sk_7f8a92b3c4e5d6"
# Set a strong secret to unlock /admin/ads and protected admin APIs.
ADMIN_API_KEY=""
