    "square":  { "w": 1080, "h": 1080, "scale": 1 },
    "flyer-a5":{ "w": 874,  "h": 1240, "scale": 2, "export": "1748x2480" },
    "seal":    { "w": 1080, "h": 1080, "transparent": true, "sizes": [1080, 512, 256, 128, 64] }
  },
  "contact": {
    "whatsapp-bot": "+234 911 516 2081",
    "whatsapp-link": "https://wa.me/2349115162081?text=Hi%20Floate%2C%20I%20dey%20find%20",
    "site": "floate.xyz"
  },
  "rules": [
    "Never redraw the logo; use layers/wordmark-* and layers/icon-* cut-outs.",
