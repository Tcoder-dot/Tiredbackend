{
  "$meta": {
    "name": "Floate design tokens",
    "version": "1.0.0",
    "date": "2026-10-27",
    "source": "design-handoff/ (Design Brief v2, official green/yellow) normalised by Backend",
    "note": "Legacy CSS var names in design-handoff/src/base.css (--purple, --violet, --gold, --lilac, --wa) map to the semantic names below. Use these names going forward."
  },
  "color": {
    "brand": {
      "green":        { "value": "#1B5E20", "legacy": "--purple", "use": "Primary. Fields, CTA buttons, headings on cream" },
