  "gradient": {
    "field-status":  { "value": "radial-gradient(1200px 900px at 50% -10%, #2E7D32 0%, #1B5E20 40%, #0E3B12 85%)", "use": "1080x1920 backgrounds" },
    "field-square":  { "value": "radial-gradient(1000px 800px at 85% 10%, #2E7D32 0%, #1B5E20 40%, #0E3B12 90%)", "use": "1080x1080 backgrounds" },
    "field-flyer":   { "value": "radial-gradient(900px 700px at 20% 0%, #2E7D32 0%, #1B5E20 45%, #0E3B12 100%)", "use": "A5 flyer header" },
    "seal":          { "value": "radial-gradient(circle at 35% 30%, #2E7D32 0%, #1B5E20 45%, #0E3B12 100%)", "use": "Verified seal centre" },
