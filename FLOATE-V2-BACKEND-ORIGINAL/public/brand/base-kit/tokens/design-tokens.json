    },
    "green": {
      "900": { "value": "#0E3B12", "legacy": "--deep",   "use": "Gradient end, outlines, dark text on yellow" },
      "800": { "value": "#145018", "use": "Photo slot fill on square" },
      "700": { "value": "#1B5E20", "use": "= brand.green" },
      "600": { "value": "#2E7D32", "legacy": "--violet", "use": "Gradient highlight, chip text" }
    },
    "neutral": {
      "paper":    { "value": "#FFFDF5", "legacy": "--paper", "use": "Reading panels, certificate card, bottom bars" },
      "chip":     { "value": "#FFF4CC", "legacy": "--lilac", "use": "Chip / tag background" },
      "ink":      { "value": "#10200F", "legacy": "--ink",   "use": "Body text on paper" },
      "text-2":   { "value": "#2F3B2F", "use": "Long body copy on paper" },
      "text-3":   { "value": "#4F5E4F", "use": "Secondary copy on paper" },
      "muted":    { "value": "#6B7A6B", "use": "Labels, meta, footers" },
