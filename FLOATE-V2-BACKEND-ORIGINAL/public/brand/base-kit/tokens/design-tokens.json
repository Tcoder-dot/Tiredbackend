    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "license": "SIL OFL 1.1 (fonts/OFL.txt). Self-hosted: never load from Google Fonts at render time."
  },
  "type-scale": {
    "_unit": "px at 1x canvas (1080 wide). Flyer values are css px at 874 wide, rendered @2x.",
    "status": { "brand-lockup": 78, "kicker": 28, "headline": 96, "name": 76, "biz": 36, "body": 29, "chip": 24, "meta-label": 22, "meta-value": 32, "footer": 34 },
    "square": { "brand-lockup": 60, "tag": 24, "headline": 88, "body": 30, "cta": 34, "url": 28 },
    "flyer":  { "brand-lockup": 50, "pidgin": 30, "headline": 78, "sub": 24, "step-title": 25, "step-body": 22, "cta": 21, "foot": 15 },
    "letter-spacing": { "kicker": "9px", "tag": "3px", "headline": "-2px", "meta-label": "3px" },
    "line-height": { "headline": 1.0, "body": 1.4 }
