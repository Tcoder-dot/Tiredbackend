      "sans":  { "value": "'Instrument Sans', system-ui, sans-serif", "files": ["fonts/InstrumentSans-Variable.ttf", "fonts/InstrumentSans-Italic-Variable.ttf"] },
      "serif": { "value": "'Instrument Serif', Georgia, serif", "files": ["fonts/InstrumentSerif-Regular.ttf", "fonts/InstrumentSerif-Italic.ttf"], "use": "Italic, one yellow emphasis word per headline" }
