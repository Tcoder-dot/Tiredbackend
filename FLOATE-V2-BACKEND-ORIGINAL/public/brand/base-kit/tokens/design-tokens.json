  "radius": { "chip": 40, "button": 22, "panel": 28, "card": 36, "frame-outer": 24, "frame-inner": 18, "pill": 9999 },
  "border": { "gold-frame": "3px solid #FFC107", "inner-frame": "1.5px solid rgba(27,94,32,.25)", "meta-divider": "2px dashed rgba(27,94,32,.25)" },
  "shadow": { "card": "0 30px 80px rgba(0,0,0,.35)", "panel": "0 12px 30px rgba(14,59,18,.15)", "float": "0 20px 40px rgba(0,0,0,.3)" },
